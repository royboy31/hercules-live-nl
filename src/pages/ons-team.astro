---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'Ons team | Hercules Merchandise';
const pageDescription = "Maak kennis met de mensen achter Hercules Merchandise — de projectmanagers, designers en developers die uw merchandiseproject op maat begeleiden, van concept tot levering.";

const team = [
  {
    name: 'Cedric',
    role: 'Projectmanager',
    image: '/images/team/cedric.webp',
    favourite: 'HD-voetbalsjaal',
    linkedin: 'https://www.linkedin.com/in/cedricdeschrijver/',
    bio: "Voor Cedric komt de klant altijd op de eerste plaats. Hij communiceert helder, gestructureerd en attent, neemt de tijd om de behoeften van elke klant te begrijpen en houdt projecten op koers. Daarnaast werkt hij aan betere interne processen, houdt hij de documentatie up-to-date en ondersteunt hij de marketingstrategie, zodat Hercules Merchandise professioneel, relevant en eenvoudig in de samenwerking blijft."
  },
  {
    name: 'Gilles',
    role: 'Projectmanager',
    image: '/images/team/gilles.webp',
    favourite: 'Retro voetbalshirt',
    linkedin: 'https://www.linkedin.com/in/gillesvandoorne/',
    bio: "Gilles helpt klanten hun ideeën om te zetten in duidelijke en haalbare merchandiseprojecten. Hij wil precies begrijpen wat elke club, elk merk of elke organisatie wil bereiken, en begeleidt het project van het eerste idee tot de uiteindelijke levering. Met een praktische kijk op ontwerp, productie en planning zorgt hij ervoor dat klanten eerlijk, nuttig en makkelijk toepasbaar advies krijgen."
  },
  {
    name: 'Lea-Marie',
    role: 'Projectmanager',
    image: '/images/team/lea-marie.webp',
    favourite: 'Sjaal in gerecycleerd katoen',
    linkedin: 'https://www.linkedin.com/in/lea-marie-g%C3%B6tze/',
    bio: "Lea-Marie zorgt ervoor dat projecten op de Britse en Duitse markt vlot verlopen. Georganiseerd, toegankelijk en met oog voor detail helpt ze de ideeën van klanten om te zetten in passende producten, en zorgt ze ervoor dat onderweg niets over het hoofd wordt gezien. Ze werkt ook mee aan de website door nieuwe producten toe te voegen en de productinformatie actueel, duidelijk en nuttig te houden voor klanten."
  },
  {
    name: 'Zhaks',
    role: 'Designer',
    image: '/images/team/zhaks.webp',
    favourite: 'Muts op maat',
    linkedin: null,
    bio: "Zhaks maakt merchandiseontwerpen voor sportclubs, merken en organisaties. Zijn werk omvat van alles, van sjaals en breiwerk tot verpakkingen, vlaggen en promotieartikelen. Hij vertrekt graag van een idee en maakt er een afgewerkt product van dat er goed uitziet, werkt in productie en dat mensen echt kunnen gebruiken, dragen en waarderen."
  },
  {
    name: 'Dilan',
    role: 'Designer',
    image: '/images/team/dilan.webp',
    favourite: 'Sjaal op maat',
    linkedin: null,
    bio: "Dilan zet de ideeën van klanten om in productieklare ontwerpen. Elk product brengt zijn eigen uitdagingen mee, van voetbalsjaals en voetbalshirts tot vaantjes, handdoeken en andere artikelen op maat, en hij zorgt er graag voor dat elk detail klopt vóór het drukken. Zijn favoriete product is de sjaal op maat, omdat die eindeloze creatieve mogelijkheden biedt, van uitgesproken supporterskleuren tot gedetailleerde geweven motieven."
  },
  {
    name: 'Roy',
    role: 'Developer',
    image: '/images/team/roy.webp',
    favourite: 'Voetbalshirt op maat',
    linkedin: null,
    bio: "Roy werkt eraan om de website van Hercules Merchandise zo duidelijk, eenvoudig en aangenaam mogelijk te maken. Zijn doel: dat elke klant de producten kan verkennen, de beschikbare opties begrijpt en de prijzen duidelijk ziet, zonder extra hulp nodig te hebben. Zijn favoriete product is het voetbalshirt op maat, omdat het mensen samenbrengt en bedrijven, clubs en supportersgroepen iets geeft waarin ze zich meteen herkennen."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageType="page"
>
  <!-- Hero Section -->
  <section class="team-hero">
    <div class="container">
      <div class="team-hero-text">
        <h1>Het team achter<br />Hercules Merchandise</h1>
        <div class="hero-accent"></div>
        <p>Achter elk geslaagd project staat een team van mensen met oog voor detail. Bij Hercules Merchandise werkt u met echte mensen die uw project begeleiden van concept tot levering, met productkennis, praktisch advies en aandacht voor elk detail.</p>
        <p>We geloven in eerlijke communicatie, realistische levertijden en ontwerpen die gemaakt zijn voor productie. Ons doel is eenvoudig: het proces makkelijk, transparant en aangenaam maken, en merchandise leveren die uw community met trots draagt.</p>
      </div>
    </div>
  </section>

  <!-- Our Team -->
  <section class="team-section">
    <div class="container">
      <h2 class="section-title">Ons team</h2>
      <p class="section-intro">De mensen die uw project begeleiden, uw ontwerpen vormgeven en de zaken in beweging houden.</p>

      <div class="team-list">
        {team.map((member) => (
          <article class="team-card">
            <div class="team-photo">
              <img src={member.image} alt={`${member.name} — ${member.role} bij Hercules Merchandise`} width="140" height="140" loading="lazy" />
            </div>
            <div class="team-identity">
              <h3>{member.name}</h3>
              <p class="team-role">{member.role}</p>
            </div>
            <div class="team-bio">
              <p>{member.bio}</p>
            </div>
            <div class="team-meta">
              <p class="team-favourite"><span>Favoriet merchandiseartikel:</span>{member.favourite}</p>
              {member.linkedin && (
                <a class="team-linkedin" href={member.linkedin} target="_blank" rel="noopener noreferrer">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                  LinkedIn
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="team-section team-section-alt">
    <div class="container">
      <h2 class="section-title">Onze manier van werken</h2>
      <p class="section-intro">We volgen een eenvoudig, beproefd proces waarin uw doelen voorop staan. We luisteren, adviseren en begeleiden u bij elke beslissing, zodat u altijd weet wat er gebeurt en waarom. Onze principes houden projecten op koers en uw ervaring zorgeloos.</p>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#10C99E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              <line x1="8" y1="9" x2="16" y2="9"></line>
              <line x1="8" y1="13" x2="13" y2="13"></line>
            </svg>
          </div>
          <h3>Eerlijk advies</h3>
          <p>We raden aan wat werkt, niet alleen wat goed klinkt. Rechtstreeks advies waarop u kunt vertrouwen.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#10C99E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <h3>Oog voor detail</h3>
          <p>Van het nakijken van ontwerpen tot het plannen van leveringen: we focussen op de kleine dingen die een groot verschil maken.</p>
        </div>

        <div class="value-card">
          <div class="value-icon">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="#10C99E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path>
            </svg>
          </div>
          <h3>Visie op lange termijn</h3>
          <p>We bouwen aan betrouwbare partnerschappen en geven om uw succes, vandaag en in de seizoenen die komen.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Hero Section */
  .team-hero {
    background: #EFF4FA;
    padding: 70px 0;
  }

  .team-hero-text {
    max-width: 760px;
  }

  h1 {
    font-family: 'Jost', sans-serif;
    font-size: 48px;
    font-weight: 600;
    color: #253461;
    text-transform: uppercase;
    line-height: 1.15;
    margin: 0 0 18px;
  }

  .hero-accent {
    width: 70px;
    height: 4px;
    background: #10C99E;
    margin: 0 0 25px;
  }

  .team-hero-text p {
    font-family: 'Roboto', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: #5F5F5F;
    margin: 0 0 15px;
  }

  /* Shared Section Styles */
  .team-section {
    padding: 70px 0;
    background: #FFFFFF;
  }

  .team-section-alt {
    background: #FAFAFA;
  }

  .section-title {
    font-family: 'Jost', sans-serif;
    font-size: 35px;
    font-weight: 600;
    color: #253461;
    text-transform: uppercase;
    text-align: center;
    margin: 0 0 15px;
  }

  .section-intro {
    font-family: 'Roboto', sans-serif;
    font-size: 17px;
    line-height: 1.7;
    color: #5F5F5F;
    text-align: center;
    max-width: 750px;
    margin: 0 auto;
  }

  /* Team Cards */
  .team-list {
    display: flex;
    flex-direction: column;
    gap: 25px;
    margin-top: 45px;
  }

  .team-card {
    display: grid;
    grid-template-columns: 140px 170px 1fr 220px;
    gap: 30px;
    align-items: center;
    background: #FFFFFF;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .team-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .team-photo img {
    display: block;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #EFF4FA;
  }

  .team-identity h3 {
    font-family: 'Jost', sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #253461;
    text-transform: uppercase;
    margin: 0 0 5px;
  }

  .team-role {
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: #10C99E;
    margin: 0;
  }

  .team-bio p {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #5F5F5F;
    margin: 0;
  }

  .team-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .team-favourite {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.5;
    color: #253461;
    margin: 0;
  }

  .team-favourite span {
    display: block;
    font-weight: 700;
    margin-bottom: 3px;
  }

  .team-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #469ADC;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .team-linkedin:hover {
    color: #253461;
  }

  /* Values Grid */
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    margin-top: 45px;
  }

  .value-card {
    background: #FFFFFF;
    border-radius: 15px;
    padding: 30px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);
  }

  .value-icon {
    margin-bottom: 15px;
  }

  .value-card h3 {
    font-family: 'Jost', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #253461;
    margin: 0 0 12px;
  }

  .value-card p {
    font-family: 'Roboto', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #5F5F5F;
    margin: 0;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .team-card {
      grid-template-columns: 120px 1fr;
      grid-template-rows: auto auto auto;
      row-gap: 15px;
    }

    .team-photo img {
      width: 120px;
      height: 120px;
    }

    .team-bio,
    .team-meta {
      grid-column: 1 / -1;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Mobile */
  @media (max-width: 768px) {
    .container {
      padding: 0 20px;
    }

    .team-hero {
      padding: 45px 0;
    }

    h1 {
      font-size: 30px;
    }

    .team-hero-text p {
      font-size: 15px;
    }

    .team-section {
      padding: 45px 0;
    }

    .section-title {
      font-size: 24px;
    }

    .section-intro {
      font-size: 15px;
    }

    .team-card {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: 25px 20px;
    }

    .team-photo img {
      width: 110px;
      height: 110px;
    }

    .team-bio,
    .team-meta {
      grid-column: auto;
    }

    .team-meta {
      align-items: center;
    }
  }
</style>
