---
import BaseLayout from '../layouts/BaseLayout.astro';
import Slider from '../components/Slider.astro';
import TopPerformer from '../components/TopPerformer.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import DesignService from '../components/DesignService.astro';
import HerculesMerchandise from '../components/HerculesMerchandise.astro';
import TrustLogos from '../components/TrustLogos.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import homepageData from '../data/homepage-products.json';
import { siteConfig } from '../config/seo';

// homepage-products.json stores absolute image URLs on the production worker.
// Point them at whichever lane this build targets, so a staging build does not
// read images out of the production KV (see WORKER_URL in the other pages).
const WORKER_URL = import.meta.env.WORKER_URL || 'https://hercules-product-sync-nl-prod.gilles-86d.workers.dev';
const products = homepageData.products.map((p) => ({
  ...p,
  image: typeof p.image === 'string'
    ? p.image.replace(/^https:\/\/hercules-product-sync-nl(?:-prod)?\.gilles-86d\.workers\.dev/, WORKER_URL)
    : p.image,
}));

// SEO configuration for homepage
const pageTitle = 'Sjaals, shirts en sportmerchandise op maat';
const pageDescription = 'Sjaals, shirts en sportmerchandise op maat. Gemaakt in Europa, ook in kleine aantallen. Gratis ontwerp. Al 15 jaar uw specialist.';
const ogImage = `${siteConfig.siteUrl}${siteConfig.defaultImage}`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  pageType="page"
  ogImage={ogImage}
>
  <!-- Hero Slider Section -->
  <Slider />

  <!-- Top Performer in the Spotlight Section -->
  <TopPerformer products={products} />

  <!-- Why Choose Us Section -->
  <WhyChooseUs />

  <!-- Design Service Section -->
  <DesignService />

  <!-- Hercules Merchandise About Section -->
  <HerculesMerchandise />

  <!-- They Trust Us - Trust Logos Section -->
  <TrustLogos />

  <!-- What Customers Say About Us - Customer Reviews Section -->
  <CustomerReviews />
</BaseLayout>
