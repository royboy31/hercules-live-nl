---
// Ce que les clients disent de nous - Customer Reviews Section
// Uses TrustIndex widget for Google Reviews (NL widget, Google profile "Hercules Merchandise NL")
// TrustIndex logo replaced with Google logo via JS
// Script loaded dynamically after React hydration to avoid hydration mismatch (error #418)
---

<section class="reviews-section" id="review-section">
  <div class="reviews-container">
    <h2 class="section-heading">
      Wat klanten <span class="highlight">over ons zeggen</span>
    </h2>

    <!-- TrustIndex Widget - NL widget (hercules-merchandise.nl, Slider I light border) -->
    <div class="reviews-widget" id="trustindex-widget-home"></div>
  </div>
</section>

<style>
  .reviews-section {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 80px 0 50px 0;
  }

  .reviews-container {
    width: 100%;
  }

  .section-heading {
    font-family: 'Jost', sans-serif;
    font-size: 35px;
    font-weight: 600;
    text-transform: uppercase;
    color: #253461;
    text-align: center;
    margin: 0 0 55px 0;
  }

  .section-heading .highlight {
    color: #469ADC;
  }

  .reviews-widget {
    width: 100%;
    min-height: 300px;
  }

  /* Hide only TrustIndex branding/powered-by links, not the review count link */
  :global(.ti-widget .ti-footer-text a[href*="trustindex"]),
  :global(.ti-widget a[title*="Trustindex"]),
  :global(.ti-widget a[title*="trustindex"]) {
    display: none !important;
  }

  /* Tablet */
  @media (max-width: 1024px) {
    .section-heading {
      font-size: 30px;
    }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .reviews-section {
      padding: 40px 20px;
    }

    .section-heading {
      font-size: 28px;
    }
  }
</style>

<script is:inline>
  (function() {
    var container = document.getElementById('trustindex-widget-home');
    if (!container) return;
    var section = container.closest('.reviews-section');

    var CORRECT_MAPS_URL = 'https://www.google.com/maps/place/Hercules+Merchandise+NL/data=!4m2!3m1!1s0x8565f6c310e115b1:0xe2cb88b822f6b3c4';

    function fixReviewLinks(root) {
      var links = root.querySelectorAll('a[href*="admin.trustindex.io"]');
      links.forEach(function(a) {
        a.href = CORRECT_MAPS_URL;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
      });
      var items = root.querySelectorAll('[data-platform-page-url*="admin.trustindex.io"]');
      items.forEach(function(el) {
        el.setAttribute('data-platform-page-url', CORRECT_MAPS_URL);
      });
    }

    function loadWidget() {
      var script = document.createElement('script');
      script.src = 'https://cdn.trustindex.io/loader.js?b323efb8230e1805d266c7ef231';
      script.defer = true;
      script.async = true;
      container.appendChild(script);

      var linkObserver = new MutationObserver(function() {
        fixReviewLinks(container);
      });
      linkObserver.observe(container, { childList: true, subtree: true });
    }

    // Defer loading until section is near viewport (below the fold)
    if ('IntersectionObserver' in window) {
      var obs = new IntersectionObserver(function(entries) {
        if (entries[0].isIntersecting) {
          obs.disconnect();
          loadWidget();
        }
      }, { rootMargin: '200px' });
      obs.observe(section || container);
    } else {
      // Fallback: load after 12s
      setTimeout(loadWidget, 12000);
    }
  })();
</script>
